# 공공데이터포털(data.go.kr) 서비스 키: 온비드 공매물건, 국토부 실거래가, 건축물대장
DATA_GO_KR_SERVICE_KEY=

# 카카오 로컬 API: 주소 → 좌표, 주변 지하철역 검색
KAKAO_REST_API_KEY=

# (선택) TMAP 보행자 경로 API: 실제 도보 거리·시간
TMAP_APP_KEY=

# Claude API: 매각물건명세서·등기부 등 PDF 구조화 추출
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# 저장소
DATABASE_URL=sqlite:///data/auction_lens.db
DATA_DIR=./data
